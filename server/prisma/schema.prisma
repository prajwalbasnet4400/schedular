// Data model for the Automated College Timetable Generator.
// Entities follow proposal section 4.3.4 "Description of Key System Entities".
// NFR3 requires persistence "in a relational database with appropriate foreign key
// constraints and data validation" -- every relation below is a real FK.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Day {
  SUN
  MON
  TUE
  WED
  THU
  FRI
}

enum RoomType {
  LECTURE_HALL
  LAB
}

enum CourseType {
  LECTURE
  LAB
}

enum SessionType {
  LECTURE
  LAB
}

enum UserRole {
  ADMIN
  VIEWER
}

enum RunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  INFEASIBLE
}

/// FR6: role-based access control distinguishing administrators from viewers.
model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  role         UserRole      @default(VIEWER)
  createdAt    DateTime      @default(now())
  runs         ScheduleRun[]
}

/// An academic department, e.g. Computer Science.
model Department {
  id          String       @id @default(cuid())
  code        String       @unique
  name        String
  courses     Course[]
  instructors Instructor[]
  programs    Program[]
}

/// A degree programme, e.g. B.Sc. CSIT. Batches belong to a programme.
model Program {
  id             String     @id @default(cuid())
  code           String     @unique
  name           String
  totalSemesters Int        @default(8)
  departmentId   String
  department     Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  batches        Batch[]
}

/// A subject offered by a department.
model Course {
  id              String       @id @default(cuid())
  code            String       @unique
  name            String
  creditHours     Int
  /// Weekly 1-hour lecture sessions. Each becomes one gene in the chromosome.
  lecturesPerWeek Int          @default(3)
  /// Weekly lab sessions. Each lab occupies two consecutive periods.
  labsPerWeek     Int          @default(0)
  type            CourseType   @default(LECTURE)
  departmentId    String
  department      Department   @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  instructors     Instructor[] @relation("InstructorQualification")
  batches         Batch[]      @relation("BatchEnrolment")
  assignments     ScheduleAssignment[]
}

/// A teacher, with the courses they may teach and the slots they are free for.
model Instructor {
  id           String                   @id @default(cuid())
  name         String
  email        String                   @unique
  departmentId String
  department   Department               @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  /// FR1: "teachers with subject expertise and availability".
  courses      Course[]                 @relation("InstructorQualification")
  availability InstructorAvailability[]
  assignments  ScheduleAssignment[]
}

/// Explicit join table so availability can carry attributes and be edited slot by slot.
model InstructorAvailability {
  instructorId  String
  meetingTimeId String
  isAvailable   Boolean     @default(true)
  instructor    Instructor  @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  meetingTime   MeetingTime @relation(fields: [meetingTimeId], references: [id], onDelete: Cascade)

  @@id([instructorId, meetingTimeId])
}

/// A physical classroom or laboratory.
model Room {
  id          String               @id @default(cuid())
  number      String               @unique
  building    String               @default("Main")
  capacity    Int
  type        RoomType             @default(LECTURE_HALL)
  assignments ScheduleAssignment[]
}

/// A group of students in one programme and semester, e.g. B.Sc. CSIT Semester V.
model Batch {
  id           String               @id @default(cuid())
  programId    String
  program      Program              @relation(fields: [programId], references: [id], onDelete: Restrict)
  semester     Int
  section      String               @default("A")
  studentCount Int
  courses      Course[]             @relation("BatchEnrolment")
  assignments  ScheduleAssignment[]

  @@unique([programId, semester, section])
}

/// One slot in the weekly grid, e.g. Sunday period 1 (06:30-07:30).
model MeetingTime {
  id           String                   @id @default(cuid())
  day          Day
  period       Int
  startTime    String
  endTime      String
  availability InstructorAvailability[]
  assignments  ScheduleAssignment[]

  @@unique([day, period])
}

/// One execution of the Genetic Algorithm, with its parameter snapshot and results.
/// Storing the config alongside the outcome is what makes Expected Outcome 5
/// ("comparative analysis of different parameter configurations") a query rather than
/// a spreadsheet maintained by hand.
model ScheduleRun {
  id              String               @id @default(cuid())
  status          RunStatus            @default(PENDING)
  /// GAConfig snapshot as used for this run.
  config          Json
  bestFitness     Float                @default(0)
  generationsRun  Int                  @default(0)
  durationMs      Int                  @default(0)
  hardViolations  Int                  @default(0)
  softViolations  Int                  @default(0)
  /// FitnessBreakdown of the winning chromosome.
  breakdown       Json?
  /// GenerationProgress[] -- the convergence curve, the report's key figure.
  convergence     Json?
  message         String?
  createdAt       DateTime             @default(now())
  completedAt     DateTime?
  createdById     String
  createdBy       User                 @relation(fields: [createdById], references: [id], onDelete: Restrict)
  assignments     ScheduleAssignment[]

  @@index([status, createdAt])
}

/// One decoded gene of the winning chromosome: a class session placed in the week.
model ScheduleAssignment {
  id             String      @id @default(cuid())
  runId          String
  run            ScheduleRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course      @relation(fields: [courseId], references: [id], onDelete: Restrict)
  instructorId   String
  instructor     Instructor  @relation(fields: [instructorId], references: [id], onDelete: Restrict)
  roomId         String
  room           Room        @relation(fields: [roomId], references: [id], onDelete: Restrict)
  meetingTimeId  String
  meetingTime    MeetingTime @relation(fields: [meetingTimeId], references: [id], onDelete: Restrict)
  batchId        String
  batch          Batch       @relation(fields: [batchId], references: [id], onDelete: Restrict)
  sessionType    SessionType @default(LECTURE)
  /// Genes of a two-period lab share this id and are moved together.
  sessionGroupId String

  @@index([runId])
  @@index([runId, batchId])
  @@index([runId, instructorId])
  @@index([runId, roomId])
}
